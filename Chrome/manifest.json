{
  "manifest_version": 3,
  "name": "OnlineSubtitle",
  "description": "__MSG_extensionDescription__",
  "version": "0.4.6",
  "minimum_chrome_version": "116",
  "default_locale": "en",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["captions.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["sound-labels.js", "sentences.js", "subtitle-interactions.js", "content.js"],
      "css": ["subtitles.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["netflix-timedtext.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["sound-labels.js", "subtitle-interactions.js", "netflix.js"],
      "css": ["subtitles.css", "netflix.css"],
      "run_at": "document_start"
    }
  ]
}
