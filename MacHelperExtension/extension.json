  "entryPoint": "Main.swift",
  "icon": "assets/icon.png",
  "permissions": ["native.execute", "ai.transform", "companion.message"],
  "companion": { "chromeExtensionID": "ndmbmmhddeibbojclldpaabmkcielfmj" },
  "commands": [
    { "identifier": "status", "title": "OnlineSubtitle status", "trigger": "manual" },
    { "identifier": "translate-captions", "title": "Translate captions", "trigger": "companion" },
    { "identifier": "caption-settings", "title": "Read caption preferences", "trigger": "companion" },
    { "identifier": "explain-word", "title": "Explain clicked word", "trigger": "companion" }
  ],
  "settingsSchema": "settings.schema.json",
  "localizations": "localizations.json"
}
